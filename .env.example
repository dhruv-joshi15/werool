# Local React development origin; comma-separated exact origins, no secrets.
CORS_ORIGINS=http://localhost:5173
# Optional absolute path to a saved snapshot directory; default is root/data.
# DATA_DIR=/absolute/path/to/data
PORT=8000

# Compose host port; container always listens on 8000.
BACKEND_PORT=8000
# Optional dashboard Compose profile host port.
FRONTEND_PORT=5173
